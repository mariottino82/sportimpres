# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Configuration for Appointment Confirmation Emails
# Configura i parametri del provider SMTP (es. Aruba: smtps.aruba.it, porta 465 SSL o 587 STARTTLS)
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sportelloimprese@tuodominio.it
SMTP_PASS=tuapassword

# Alias Mittente e Indirizzo (Visualizzati come mittente nei client di posta: Aruba, Outlook, Gmail)
# Se omesso, il nome predefinito è "Sportello Imprese Molise" e l'indirizzo usa SMTP_USER o sportelloimprese@sviluppoitaliamolise.it
SMTP_FROM_NAME="Sportello Imprese Molise"
SMTP_FROM_EMAIL=sportelloimprese@tuodominio.it

# Indirizzo a cui giungono le risposte se il cittadino preme "Rispondi" nel proprio client email (Reply-To)
SMTP_REPLY_TO=sportelloimprese@sviluppoitaliamolise.it

# Configurazione Database SQLite (Server Ubuntu / Produzione)
# Percorso personalizzato del file SQLite (default: ./sportello.db)
DATABASE_PATH=

# Dati di prova (utenti, appuntamenti e interazioni fittizie)
# In produzione (quando pubblichi) è SEMPRE disattivato (false) e non inserisce mai dati fittizi.
# Impostare a true SOLO in locale se si desiderano record dimostrativi.
SEED_SAMPLE_DATA=false

# Impostare a true all'avvio su Ubuntu se si desidera rimuovere automaticamente eventuali vecchi dati di prova residui
PURGE_SAMPLE_DATA=false
